{
	"include": ["./src/**/*.ts"],
	"compilerOptions": {
		"target": "ESNext",
		"module": "nodenext",
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"strict": true,
		"moduleResolution": "nodenext",
		"types": ["node"],
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	}
}
